# =============================================
# OpenMars 环境变量配置模板
# 复制此文件为 .env 并填写你的配置
# 支持所有符合 OpenAI 标准的大模型（Claude/GPT/DeepSeek/豆包/通义千问/本地开源模型）
# =============================================

# ================= 核心大模型配置（必填） =================
# 【首选·永久免费】智谱GLM-4-Flash 番茄小说审核专属配置
# 智谱开放平台注册实名即送永久免费额度：https://open.bigmodel.cn/
LLM_API_KEY=你的智谱API_Key（注册实名后获取）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL_NAME=glm-4-flash

# 大模型接口地址示例（绝大多数服务商必须以 /v1 结尾）：
# OpenAI: https://api.openai.com/v1
# Anthropic Claude: https://api.anthropic.com/v1
# DeepSeek: https://api.deepseek.com/v1
# 字节豆包: https://ark.cn-beijing.volces.com/api/v1
# 本地Ollama: http://localhost:11434/v1

# ================= 生成参数 =================
# 模型温度系数（0-1，越高越随机，网文创作推荐0.7-0.8）
LLM_TEMPERATURE=0.7
# 单轮最大输出Token数（0表示不限制，交由服务商按模型上限决定；如需限制请按所用模型上限填写）
LLM_MAX_TOKENS=0
# 模型调用超时时间（秒，0表示使用SDK默认超时）
LLM_TIMEOUT=0
# 生成最大重试次数
MAX_RETRY=3
# 写后记忆抽取模型（可选）：每章生成完毕后追加一次结构化抽取调用更新记忆库（伏笔台账/角色状态/滚动摘要），
# 指定便宜模型可省成本（如 glm-4-flash）；留空则使用上方主模型
LLM_EXTRACT_MODEL_NAME=

# ================= 番茄审核专属核心参数（已接入质量门禁 validators） =================
# 番茄建议区间上限：运行报告 platform_hint 的建议边界；目标字数未提供时作字数门禁兜底基准
MAX_CHAPTER_WORDS=4500
# 番茄审核兼容模式总开关：true=门禁不达标自动定向重写（最多2轮）；false=门禁仅出报告、不强制重写
TOMATO_AUDIT_COMPATIBLE=true
# 一致性审校开关：true=每章生成后追加一次独立审校调用，对照人物档案+伏笔台账输出可疑点清单；
# false=关闭审校，零额外LLM调用
CONTENT_SAFETY_CHECK=true

# ================= 运行报告成本估算（可选） =================
# 配置单价（元/百万Token）后，每章运行报告（output/<书>/第N章_报告.json）会附估算成本；
# 留空或0则只记 token 不算钱
LLM_PRICE_IN_PER_1M=0
LLM_PRICE_OUT_PER_1M=0

# ================= 移动端告警配置（可选） =================
# 支持Bark/Server酱/飞书/钉钉
# Bark iOS: https://api.day.app/你的BarkToken
# Server酱: https://sctapi.ftqq.com/你的SendKey.send
# 飞书/钉钉自定义机器人: https://open.feishu.cn/open-apis/bot/v2/hook/你的HookKey
WEBHOOK_URL=

# ================= 未来路线（预留说明，当前无需配置） =================
# 双模型路由（主脑负责调度、写手负责创作的分层模型配置）为未来路线：
# 当前版本为单模型串行流水线（写后记忆抽取已支持可选便宜模型，见上方 LLM_EXTRACT_MODEL_NAME），完整分层配置将在后续版本引入，届时会在此补充对应模板项。
